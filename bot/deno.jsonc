{
  "permissions": {
    "default": {
      "env": true,
      "net": true, // for API requests from dashboard
      "sys": true, // sqlite3 checks the number of CPUs
      "ffi": true, // sqlite3 is a system library invoked via ffi
      "read": true, // filesystem access is gated by docker
      "write": ["../data"]
    }
  }
}